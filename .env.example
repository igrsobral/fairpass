# Copy to .env and fill in secrets. Local defaults work out of the box.
#
# NOTE: host ports are 5433 (postgres), 6380 (redis), 6335 (qdrant) to avoid
# clashes with other dev services bound to the default ports on this machine.

# --- PostgreSQL (docker-compose) ---
DATABASE_URL=postgres://fairpass:fairpass@localhost:5433/fairpass

# --- Redis (docker-compose) ---
REDIS_URL=redis://localhost:6380

# --- Qdrant (docker-compose) ---
QDRANT_URL=http://localhost:6335

# --- OpenAI ---
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Web ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI engine prefix-based overrides (FAIRPASS_*) ---
FAIRPASS_DATABASE_URL=postgres://fairpass:fairpass@localhost:5433/fairpass
FAIRPASS_REDIS_URL=redis://localhost:6380
FAIRPASS_QDRANT_URL=http://localhost:6335
FAIRPASS_OPENAI_API_KEY=